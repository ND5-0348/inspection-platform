<view class="page">
  <view class="section-title"><text>任务清单</text><small>下拉可刷新</small></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!loading && tasks.length === 0}}" class="empty"><text>暂无分配给你的任务</text><small>管理员派发后会显示在这里</small></view>
  <view class="card task" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask">
    <view class="task-head"><text class="task-no">{{item.taskNo}}</text><text class="status">{{item.status === 'PENDING_ACCEPTANCE' ? '待接单' : item.status === 'IN_PROGRESS' ? '执行中' : '已接单'}}</text></view>
    <text class="muted">派发时间 {{item.assignedAt}}</text>
    <view class="task-foot"><text>查看任务详情</text><text>›</text></view>
  </view>
</view>

