.header-card { position: relative; margin-bottom: 22rpx; padding: 36rpx 30rpx; border-radius: 22rpx; background: #17484d; color: #fff; }.eyebrow { display: block; color: #cfe789; font-size: 21rpx; letter-spacing: 2rpx; }.title { display: block; max-width: 500rpx; margin: 20rpx 0 8rpx; font-size: 36rpx; font-weight: 800; }.order-no { display: block; color: #b7cfcd; font-size: 21rpx; }.header-card .status { position: absolute; right: 25rpx; top: 25rpx; }
.detail-list view { display: grid; grid-template-columns: 150rpx 1fr; padding: 18rpx 0; border-bottom: 1rpx solid #edf1ef; }.detail-list view:last-child { border: 0; }.detail-list text { color: #7d9295; font-size: 23rpx; }.detail-list strong { color: #28484e; font-size: 24rpx; font-weight: 600; }
.card-title { display: block; margin-bottom: 20rpx; font-weight: 800; }.steps view { display: flex; align-items: center; gap: 18rpx; margin: 18rpx 0; color: #60787d; font-size: 24rpx; }.steps i { display: grid; place-items: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: #e8f0ed; color: #286c6c; font-size: 20rpx; font-style: normal; font-weight: 800; }
.material { padding: 22rpx 0; border-top: 1rpx solid #e7edeb; }.material:first-of-type { border-top: 0; }.material-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 12rpx; }.material-head strong { color: #28484e; font-size: 25rpx; }.material-head text { flex: 0 0 auto; padding: 5rpx 12rpx; border-radius: 18rpx; background: #e6f1a9; color: #36544c; font-size: 20rpx; font-weight: 800; }.material > text { display: block; margin-top: 8rpx; color: #74898c; font-size: 21rpx; line-height: 1.5; }
