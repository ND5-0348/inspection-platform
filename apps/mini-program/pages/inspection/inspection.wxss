.progress-card { margin-bottom: 22rpx; padding: 34rpx 30rpx; border-radius: 22rpx; background: #16464c; color: #fff; }.eyebrow { display: block; color: #dcef86; font-size: 20rpx; letter-spacing: 2rpx; }.title { display: block; margin: 15rpx 0 25rpx; font-size: 34rpx; font-weight: 800; }.steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; }.steps text { padding: 10rpx 5rpx; border-radius: 8rpx; background: #ffffff12; color: #a9c1bf; font-size: 19rpx; text-align: center; }.steps text.done { background: #dcef86; color: #19444a; font-weight: 800; }
.card-title { display: block; margin-bottom: 12rpx; font-size: 28rpx; font-weight: 800; }.block { display: block; margin-bottom: 22rpx; line-height: 1.6; }.action-card .primary { margin-top: 24rpx; }.completion { display: flex; justify-content: space-between; margin-bottom: 22rpx; padding: 20rpx 24rpx; border-radius: 14rpx; background: #e4f3eb; color: #35745b; }.completion text { font-weight: 800; }.completion small { font-size: 20rpx; }
label { display: block; margin-top: 18rpx; color: #60777b; font-size: 22rpx; }.picker, input { margin-top: 10rpx; padding: 18rpx; border: 1rpx solid #dce5e2; border-radius: 10rpx; background: #fafcfb; color: #29484d; }.number-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx 20rpx; }.candidate { margin: 25rpx 0; padding: 18rpx; border-radius: 10rpx; background: #f0f5f2; color: #6f8588; font-size: 22rpx; }.candidate strong { color: #1c6063; font-size: 34rpx; }
.selected-material { margin-top: 18rpx; padding: 18rpx; border-left: 6rpx solid #d9eb82; border-radius: 10rpx; background: #f3f7f4; }.selected-material strong, .selected-material text { display: block; }.selected-material strong { color: #28494e; font-size: 24rpx; }.selected-material text { margin-top: 8rpx; color: #71878a; font-size: 20rpx; line-height: 1.5; }
.position { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; border-top: 1rpx solid #e8edeb; }.position > text { display: grid; place-items: center; width: 48rpx; height: 48rpx; border-radius: 50%; background: #dff08a; color: #18454a; font-size: 20rpx; font-weight: 800; }.position strong, .position small { display: block; }.position strong { font-size: 24rpx; }.position small { margin-top: 5rpx; color: #819496; font-size: 20rpx; }
.evidence-head { display: flex; align-items: center; justify-content: space-between; }.evidence-head button { margin: 0; color: #286c6d; }.file { display: flex; justify-content: space-between; padding: 16rpx 0; border-top: 1rpx solid #e6ecea; font-size: 22rpx; }.file small { color: #8b9b9d; }.result-row { padding: 20rpx 0; border-top: 1rpx solid #e6ecea; }.result-row strong, .result-row small { display: block; }.result-row strong { font-size: 23rpx; }.result-row small { margin: 6rpx 0 12rpx; color: #8a999b; font-size: 19rpx; }.result-row .small { padding: 14rpx; font-size: 22rpx; }.result-row input { box-sizing: border-box; width: 100%; font-size: 22rpx; }.button-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15rpx; margin-top: 20rpx; }.button-row button { font-size: 24rpx; }
.waiting { padding: 35rpx; border-radius: 18rpx; background: #eef0fa; color: #535f87; }.waiting strong, .waiting text { display: block; }.waiting strong { font-size: 29rpx; }.waiting text { margin-top: 12rpx; font-size: 23rpx; line-height: 1.6; }.waiting.complete { background: #e8f5ee; color: #356c53; }
.sample-photo-list { display: flex; align-items: center; gap: 10rpx; margin: 12rpx 0; overflow-x: auto; }.sample-photo-list image { flex: 0 0 86rpx; width: 86rpx; height: 86rpx; border-radius: 10rpx; background: #e8efec; }.sample-photo-list button { flex: 0 0 auto; margin: 0; color: #276965; font-size: 21rpx; }
