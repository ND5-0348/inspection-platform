.sample-hero { margin-bottom: 22rpx; padding: 34rpx; border-radius: 22rpx; background: #17484d; color: #fff; }.sample-hero text { color: #c2d7d5; font-size: 24rpx; }.sample-hero strong { display: block; margin: 12rpx 0; color: #e3f68e; font-size: 70rpx; }.sample-hero small { color: #b9cfcd; font-size: 22rpx; }.label { font-size: 25rpx; font-weight: 800; }
.warning { margin: 24rpx 0; padding: 25rpx; border-left: 7rpx solid #d6b653; border-radius: 10rpx; background: #fff8e8; }.warning strong, .warning text { display: block; }.warning strong { margin-bottom: 10rpx; color: #775c16; font-size: 25rpx; }.warning text { color: #8d7d54; font-size: 22rpx; line-height: 1.65; }.result-title { display: flex; justify-content: space-between; margin: 30rpx 0 18rpx; }.result-title text { font-size: 32rpx; font-weight: 800; }.result-title small { color: #819496; font-size: 22rpx; }.result { display: flex; align-items: center; gap: 22rpx; }.result .index { display: grid; place-items: center; flex: 0 0 52rpx; height: 52rpx; border-radius: 50%; background: #e5f18f; color: #17454a; font-weight: 800; }.result strong, .result view text { display: block; }.result strong { margin-bottom: 8rpx; font-size: 26rpx; }.result view text { color: #839597; font-size: 21rpx; }

