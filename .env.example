# API
API_HOST=127.0.0.1
API_PORT=3300
WEB_ORIGIN=http://127.0.0.1:5173
DATA_DRIVER=mysql
DATABASE_URL=mysql://root:change_me@localhost:3306/inspection_platform_dev
UPLOAD_DIR=data/uploads

# Reverse geocoding: osm | none | amap | baidu. Keys are kept only by the API service.
MAP_PROVIDER=osm
# OSM_REVERSE_URL 可切换为自建或商业兼容服务；高频使用请配置高德/百度 Web 服务 Key。
# OSM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
AMAP_WEB_SERVICE_KEY=
BAIDU_MAP_AK=

# Evidence storage adapter reserved for cloud deployment: local | tianyi-zos | tencent-cos
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=inspection-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Local object storage (reserved for the evidence-upload milestone)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=inspection-evidence
OBJECT_STORAGE_ACCESS_KEY=inspection
OBJECT_STORAGE_SECRET_KEY=inspection_dev_secret
